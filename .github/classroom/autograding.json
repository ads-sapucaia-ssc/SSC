{
  "//": "FALLBACK ESTATICO. O grader ATIVO do Classroom e .github/workflows/classroom.yml, que combina estas checagens estaticas COM a nota comportamental (testes @security contra MySQL). Este arquivo fica como documentacao/fallback. Nao confie so no estatico: um grupo pode remover o padrao sem corrigir a logica - por isso o classroom.yml roda tambem os testes de comportamento.",
  "tests": [
    {
      "name": "V-02 PasswordEncoder Argon2id/bcrypt (fora de comentario)",
      "setup": "",
      "run": "grep -rhE 'Argon2PasswordEncoder\\.defaults|new (Argon2|BCrypt)PasswordEncoder' legacy-app/backend/src/main | grep -qvE '^[[:space:]]*(\\*|//)' && echo PASS",
      "input": "",
      "output": "PASS",
      "comparison": "included",
      "timeout": 1,
      "points": 15
    },
    {
      "name": "V-01 sem SQL concatenado com entrada do usuario",
      "setup": "",
      "run": "! grep -rqE '\"[^\"]*\\b(WHERE|AND|OR|SET|LIKE|VALUES)\\b[^\"]*\"[[:space:]]*\\+[[:space:]]*[A-Za-z_]' legacy-app/backend/src/main && echo PASS",
      "input": "",
      "output": "PASS",
      "comparison": "included",
      "timeout": 1,
      "points": 20
    },
    {
      "name": "V-05 sem segredo hardcoded (JWT via variavel de ambiente, properties e JwtUtil)",
      "setup": "",
      "run": "! grep -qE 'jwt.secret=[^$]' legacy-app/backend/src/main/resources/application.properties && ! grep -qE 'SECRET *= *\"' legacy-app/backend/src/main/java/br/ifsul/vidaplus/security/JwtUtil.java && echo PASS",
      "input": "",
      "output": "PASS",
      "comparison": "included",
      "timeout": 1,
      "points": 15
    },
    {
      "name": "V-10 sem dangerouslySetInnerHTML no frontend",
      "setup": "",
      "run": "! grep -rq 'dangerouslySetInnerHTML' legacy-app/frontend/src && echo PASS",
      "input": "",
      "output": "PASS",
      "comparison": "included",
      "timeout": 1,
      "points": 15
    },
    {
      "name": "V-12 CORS sem allowedOrigins(*)",
      "setup": "",
      "run": "! grep -rqF 'allowedOrigins(\"*\")' legacy-app/backend/src/main && echo PASS",
      "input": "",
      "output": "PASS",
      "comparison": "included",
      "timeout": 1,
      "points": 15
    },
    {
      "name": "V-07 JWT com expiracao (.expiration ou setExpiration)",
      "setup": "",
      "run": "grep -rhE '\\.expiration\\(|setExpiration\\(' legacy-app/backend/src/main | grep -qvE '^[[:space:]]*(\\*|//)' && echo PASS",
      "input": "",
      "output": "PASS",
      "comparison": "included",
      "timeout": 1,
      "points": 20
    }
  ]
